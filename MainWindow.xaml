<Window x:Class="VilsSharpX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VILS SharpX" Width="1890" Height="1035" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">
    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F5F5F5" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="Open..." IsEnabled="False"/>
                <MenuItem Header="Save As..." IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Configuration">
                <MenuItem Header="Ethernet Configuration" Click="MenuEthernetConfig_Click"/>
                <MenuItem Header="Camera Configuration" Click="MenuCameraConfig_Click"/>
                <MenuItem Header="API Configuration" Click="MenuApiConfig_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem x:Name="MenuOsramDefectControl" Header="OSRAM Defect Injection Control" Click="MenuOsramDefectControl_Click"/>
                <MenuItem x:Name="MenuNichiaDefectControl" Header="NICHIA Defect Injection Control" Click="MenuNichiaDefectControl_Click"/>
                <MenuItem x:Name="MenuCommunicationFaultControl" Header="Communication Fault Injection Control" Click="MenuCommunicationFaultControl_Click"/>
                <MenuItem Header="Flicker Monitoring and Control" Click="MenuFlickerControl_Click"/>
                <MenuItem Header="AVTP LVDS Simulation Control" Click="MenuLvdsSimulationControl_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3.5*" />
            </Grid.ColumnDefinitions>

        <!-- A (top, spans col 0+1) -->
        <Border x:Name="PaneA" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="8" Margin="4" Padding="6" Background="#F0F0F0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="AVTP Monitor / Generator" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblA" HorizontalAlignment="Center" Foreground="DimGray" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblRunInfoA" HorizontalAlignment="Right" Foreground="DimGray" />

                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="2">
                    <Grid ClipToBounds="True">
                        <Image x:Name="ImgA" Stretch="Fill"
                              SnapsToDevicePixels="True"
                              RenderTransformOrigin="0,0"
                              RenderOptions.BitmapScalingMode="NearestNeighbor"
                              PreviewMouseWheel="Img_PreviewMouseWheel" MouseLeftButtonDown="Img_MouseLeftButtonDown" MouseLeftButtonUp="Img_MouseLeftButtonUp"
                              SizeChanged="Img_SizeChanged"
                              MouseMove="ImgA_MouseMove" MouseLeave="ImgA_MouseLeave"/>

                        <Canvas x:Name="OvrA" IsHitTestVisible="False" />

                        <Border x:Name="NoSignalA" Background="#808080" IsHitTestVisible="False" Visibility="Visible">
                            <TextBlock Text="Signal not available"
                                       Foreground="White" FontWeight="Bold" FontSize="28" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- B (middle-left: LVDS) -->
        <Border x:Name="PaneB" Grid.Row="1" Grid.Column="0" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="8" Margin="4,4,6,4" Padding="6" Background="#F0F0F0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="LVDS Monitor / Generator" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblB" HorizontalAlignment="Center" Foreground="DimGray" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblRunInfoB" HorizontalAlignment="Right" Foreground="DimGray" />

                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="2">
                    <Grid ClipToBounds="True">
                        <Image x:Name="ImgB" Stretch="Fill"
                              SnapsToDevicePixels="True"
                              RenderTransformOrigin="0,0"
                              RenderOptions.BitmapScalingMode="NearestNeighbor"
                              PreviewMouseWheel="Img_PreviewMouseWheel" MouseLeftButtonDown="Img_MouseLeftButtonDown" MouseLeftButtonUp="Img_MouseLeftButtonUp"
                              SizeChanged="Img_SizeChanged"
                              MouseMove="ImgB_MouseMove" MouseLeave="ImgB_MouseLeave"/>

                        <Canvas x:Name="OvrB" IsHitTestVisible="False" />

                        <Border x:Name="NoSignalB" Background="#808080" IsHitTestVisible="False" Visibility="Visible">
                            <TextBlock Text="Signal not available"
                                       Foreground="White" FontWeight="Bold" FontSize="28" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- C (middle-right: Basler Camera) -->
        <Border x:Name="PaneC" Grid.Row="1" Grid.Column="1" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="8" Margin="6,4,4,4" Padding="6" Background="#F0F0F0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="LSM Monitor" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblC" HorizontalAlignment="Center" Foreground="DimGray" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblRunInfoC" HorizontalAlignment="Right" Foreground="DimGray" />

                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="2">
                    <Grid ClipToBounds="True">
                        <Image x:Name="ImgC" Stretch="Fill"
                              SnapsToDevicePixels="True"
                              RenderTransformOrigin="0,0"
                              RenderOptions.BitmapScalingMode="NearestNeighbor"
                              PreviewMouseWheel="Img_PreviewMouseWheel" MouseLeftButtonDown="Img_MouseLeftButtonDown" MouseLeftButtonUp="Img_MouseLeftButtonUp"
                              SizeChanged="Img_SizeChanged"
                              MouseMove="ImgC_MouseMove" MouseLeave="ImgC_MouseLeave"/>

                        <Canvas x:Name="OvrC" IsHitTestVisible="False" />

                        <Border x:Name="NoSignalC" Background="#808080" IsHitTestVisible="False" Visibility="Visible">
                            <TextBlock Text="Signal not available"
                                       Foreground="White" FontWeight="Bold" FontSize="28" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- D (bottom, spans col 0+1: Comparison) -->
        <Border x:Name="PaneD" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="8" Margin="4" Padding="6" Background="#F0F0F0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold"><Run Text="Comparison Monitor ("/><Run x:Name="RunCompModeLabel" Text="LVDS-AVTP"/><Run Text=")"/></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblD" HorizontalAlignment="Center" Foreground="DimGray" />

                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="2">
                    <Grid ClipToBounds="True">
                        <Image x:Name="ImgD" Stretch="Fill"
                              SnapsToDevicePixels="True"
                              RenderTransformOrigin="0,0"
                              RenderOptions.BitmapScalingMode="NearestNeighbor"
                              PreviewMouseWheel="Img_PreviewMouseWheel" MouseLeftButtonDown="Img_MouseLeftButtonDown" MouseLeftButtonUp="Img_MouseLeftButtonUp"
                              SizeChanged="Img_SizeChanged"
                              MouseMove="ImgD_MouseMove" MouseLeave="ImgD_MouseLeave"/>

                        <Canvas x:Name="OvrD" IsHitTestVisible="False" />

                        <Border x:Name="NoSignalD" Background="#808080" IsHitTestVisible="False" Visibility="Visible">
                            <TextBlock Text="Signal not available"
                                       Foreground="White" FontWeight="Bold" FontSize="28" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right side: CAN/UART (spans rows 0-1: A + B/C) -->
        <GroupBox x:Name="SidebarCan" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Header="CAN/UART Monitor" Padding="8" Margin="4" Background="#F0F0F0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FBFBFB" BorderBrush="#D7D7D7" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnCanExpandCollapse" Click="BtnCanExpandCollapse_Click"
                                    Padding="0" Width="28" Height="28" Background="Transparent" BorderBrush="Transparent"
                                    ToolTip="Expand/Collapse CAN Monitor">
                                <Canvas Width="16" Height="16">
                                    <!-- Top arrow (pointing up = expand outward) -->
                                    <Path x:Name="PathExpandTop" Fill="#6F6F6F" Data="M 4,6 L 8,2 L 12,6" Stroke="#6F6F6F" StrokeThickness="1.2"/>
                                    <!-- Center bar -->
                                    <Line X1="3" Y1="8" X2="13" Y2="8" Stroke="#6F6F6F" StrokeThickness="1.5"/>
                                    <!-- Bottom arrow (pointing down = expand outward) -->
                                    <Path x:Name="PathExpandBottom" Fill="#6F6F6F" Data="M 4,10 L 8,14 L 12,10" Stroke="#6F6F6F" StrokeThickness="1.2"/>
                                </Canvas>
                            </Button>
                        </StackPanel>

                        <!-- Centered tab title -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LblCanTabTitle" Text="UART Monitor"
                                       FontWeight="Bold" FontSize="13" Foreground="#333333"
                                       VerticalAlignment="Center"/>
                            <Ellipse x:Name="CanUartStateLed" Width="10" Height="10"
                                     Fill="#A0A0A0" Stroke="#707070" StrokeThickness="1"
                                     Margin="4,0,0,0" VerticalAlignment="Center"
                                     ToolTip="CAN/UART state"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCanTabRawCan" Content="RawCan"
                                    Click="BtnCanTabRawCan_Click"
                                    FontSize="11" Padding="10,3" Margin="0,0,6,0"
                                    Background="#F6F6F6" Foreground="#444444"
                                    BorderBrush="#D8D8D8" BorderThickness="1"/>
                            <Button x:Name="BtnCanTabMonitor" Content="Monitor"
                                    Click="BtnCanTabMonitor_Click"
                                    FontSize="11" FontWeight="SemiBold" Padding="12,3" Margin="0,0,6,0"
                                    Background="#1EA6E6" Foreground="White"
                                    BorderBrush="#1EA6E6" BorderThickness="1"/>
                            <Button x:Name="BtnCanTabUart" Content="UartTransaction"
                                    Click="BtnCanTabUart_Click"
                                    FontSize="11" Padding="10,3"
                                    Background="#F6F6F6" Foreground="#444444"
                                    BorderBrush="#D8D8D8" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Monitor view (default visible) -->
                <ListView x:Name="LvCanDiag" Grid.Row="1" Margin="0,0,0,8"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MouseDoubleClick="LvCanDiag_MouseDoubleClick"
                          SizeChanged="LvCanDiag_SizeChanged"
                          GridViewColumnHeader.Click="LvCanDiag_ColumnHeaderClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time (us)" DisplayMemberBinding="{Binding Timestamp}" Width="118"/>
                            <GridViewColumn Header="Nr" DisplayMemberBinding="{Binding Number}" Width="44"/>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="96"/>
                            <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="72"/>
                            <GridViewColumn Header="MemoryType" DisplayMemberBinding="{Binding MemoryType}" Width="78"/>
                            <GridViewColumn Header="Device" DisplayMemberBinding="{Binding Device}" Width="68"/>
                            <GridViewColumn Header="R/W" DisplayMemberBinding="{Binding Operation}" Width="44"/>
                            <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="130"/>
                            <GridViewColumn Header="Error" DisplayMemberBinding="{Binding Error}" Width="80"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Height" Value="18"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Error}" Value="Timeout">
                                    <Setter Property="Background" Value="#FFEEEE"/>
                                    <Setter Property="Foreground" Value="#CC0000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Error}" Value="CRC">
                                    <Setter Property="Background" Value="#FFF3CC"/>
                                    <Setter Property="Foreground" Value="#886600"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- RawCan view (hidden by default) -->
                <ScrollViewer x:Name="ScvRawCan" Grid.Row="1" Margin="0,0,0,8"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#1E1E1E">
                    <TextBox x:Name="TblRawCan" FontFamily="Consolas" FontSize="11"
                               Foreground="#D4D4D4" Padding="8,6"
                               TextWrapping="Wrap" IsReadOnly="True"
                               Background="Transparent" BorderThickness="0"
                               VerticalScrollBarVisibility="Disabled"/>
                </ScrollViewer>

                <!-- UartTransaction view (hidden by default) -->
                <Grid x:Name="GridUartTx" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Text="UartTransaction view — coming soon." Foreground="#888888"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
                </Grid>

                <!-- Buttons row: Clear Record/Stop | Previous Next | Page jump -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Button x:Name="BtnCanClear" Content="Clear" Click="BtnCanClear_Click" Padding="10,4" Margin="0,0,6,0"/>
                        <Button x:Name="BtnCanRecord" Content="⏺ Record" Click="BtnCanRecord_Click" Width="100" Height="28" MinWidth="100" MaxWidth="100" MinHeight="28" MaxHeight="28" Padding="10,4" Margin="0,0,6,0"
                            Background="#F6F6F6" Foreground="#444444" BorderBrush="#D8D8D8" BorderThickness="1"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="CAN-UART recording is available only in ECU↔SmartVisio↔LSM or SmartVisio↔LSM mode."/>
                    <Button x:Name="BtnCanReplay" Content="▶ Replay" Click="BtnCanReplay_Click" Padding="10,4" Margin="0,0,12,0"
                        Background="#F6F6F6" Foreground="#444444" BorderBrush="#D8D8D8" BorderThickness="1" IsEnabled="False"
                        ToolTip="Replay the loaded CAN/UART trace"/>
                    <Button x:Name="BtnCanPrevPage" Content="Previous" Click="BtnCanPrevPage_Click" Padding="12,4" Margin="0,0,6,0" IsEnabled="False"/>
                    <Button x:Name="BtnCanNextPage" Content="Next" Click="BtnCanNextPage_Click" Padding="12,4" Margin="0,0,6,0" IsEnabled="False"/>
                    <TextBlock x:Name="LblCanPageInfo" Foreground="#666666" VerticalAlignment="Center" Margin="6,0,6,0"
                               Text="Page: 1 / 1"/>
                    <TextBox x:Name="TxtCanPageJump" Width="50" Padding="4,2"
                             VerticalAlignment="Center" HorizontalContentAlignment="Center"
                             KeyDown="TxtCanPageJump_KeyDown"/>
                    <Rectangle Width="1" Height="22" Fill="Gray" Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCanSaveTrace" Content="💾 Save" Click="BtnCanSaveTrace_Click" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Save trace to .rply file"/>
                    <Button x:Name="BtnCanOpenTraceFolder" Content="📂" Click="BtnCanOpenTraceFolder_Click" Padding="8,4" Margin="0,0,0,0"
                            ToolTip="Open .rply trace file"/>
                </StackPanel>

            </Grid>
        </GroupBox>

        <!-- Right side bottom: Application Options + Comparison Info + AVTP Info + LVDS Info (stacked vertically) -->
        <Grid x:Name="SidebarInfo" Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Margin="4,4,4,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Application Options -->
            <Border Grid.Row="0" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="6,6" Background="#F8F8F8">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Application Options" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6.8*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="7.7*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="5.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left column: LSM Device Type / AVTP Mode / LVDS Mode -->
                        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock Text="LSM Device Type:" VerticalAlignment="Center" Width="88" FontSize="11" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CmbLsmDeviceType" Width="116" FontSize="11" SelectedIndex="0" SelectionChanged="CmbLsmDeviceType_SelectionChanged">
                                    <ComboBoxItem Content="Osram 2.0"/>
                                    <ComboBoxItem Content="Osram 2.05"/>
                                    <ComboBoxItem Content="Nichia"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock Text="AVTP Mode:" VerticalAlignment="Center" Width="88" FontSize="11" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CmbModeOfOperation" Width="116" FontSize="11" SelectedIndex="0" SelectionChanged="CmbModeOfOperation_SelectionChanged">
                                    <ComboBoxItem Content="AVTP Monitoring"/>
                                    <ComboBoxItem Content="AVTP Generator"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                                <TextBlock Text="LVDS Mode:" VerticalAlignment="Center" Width="88" FontSize="11" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CmbLvdsMode" Width="116" FontSize="11" SelectedIndex="0" SelectionChanged="CmbLvdsMode_SelectionChanged">
                                    <ComboBoxItem Content="LVDS Monitoring"/>
                                    <ComboBoxItem Content="LVDS Generator"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Middle column: ECU Variant / Control Mode / CAN UART Mode -->
                        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="4,0,4,0">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <TextBlock Text="ECU Variant:" VerticalAlignment="Center" Width="90" FontSize="11" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbEcuVariant" Width="142" FontSize="11" SelectedIndex="0" SelectionChanged="CmbEcuVariant_SelectionChanged">
                                        <ComboBoxItem Content="MB PLU-HD 1.0 LH"/>
                                        <ComboBoxItem Content="MB PLU-HD 1.0 RH"/>
                                        <ComboBoxItem Content="MB PLU-HD 2.0 LH"/>
                                        <ComboBoxItem Content="MB PLU-HD 2.0 RH"/>
                                        <ComboBoxItem Content="MB CHLC 1.0"/>
                                        <ComboBoxItem Content="MB CHLC 2.0"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <TextBlock Text="Control Mode:" VerticalAlignment="Center" Width="90" FontSize="11" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbControlMode" Width="142" FontSize="11" SelectedIndex="0" SelectionChanged="CmbControlMode_SelectionChanged">
                                        <ComboBoxItem Content="ECU"/>
                                        <ComboBoxItem Content="Direct control"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="CAN UART Mode:" VerticalAlignment="Center" Width="90" FontSize="11" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbCanUartMode" Width="142" FontSize="11" SelectedIndex="0" SelectionChanged="CmbCanUartMode_SelectionChanged">
                                        <ComboBoxItem Content="ECU↔LSM"/>
                                        <ComboBoxItem Content="ECU↔SmartVisio↔LSM"/>
                                        <ComboBoxItem Content="SmartVisio↔LSM"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Vertical separator -->
                        <Rectangle Grid.Column="1" Width="1" Fill="Gray" Margin="2,0" HorizontalAlignment="Center"/>

                        <!-- Vertical separator -->
                        <Rectangle Grid.Column="3" Width="1" Fill="Gray" Margin="2,0" HorizontalAlignment="Center"/>

                        <!-- Right column: Comparison Mode / Dev threshold / Flip -->
                        <StackPanel Grid.Column="4" Orientation="Vertical" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock Text="Comp Mode:" VerticalAlignment="Center" Width="74" FontSize="11" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CmbComparisonMode" Width="86" FontSize="11" SelectedIndex="0" SelectionChanged="CmbComparisonMode_SelectionChanged">
                                    <ComboBoxItem Content="LVDS-AVTP"/>
                                    <ComboBoxItem Content="LSM-LVDS"/>
                                    <ComboBoxItem Content="LSM-AVTP"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock Text="Dev. threshold:" VerticalAlignment="Center" Width="74" FontSize="11" Margin="0,0,4,0"/>
                                <Border BorderBrush="#ABADB3" BorderThickness="1" Background="White" CornerRadius="2">
                                    <Grid Width="50" Height="20">
                                        <TextBox x:Name="TxtDiffThr" Text="0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" Padding="4,0,18,0" TextChanged="TxtDiffThr_TextChanged"/>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="16">
                                            <RepeatButton x:Name="BtnDiffThrUp" Content="▲" FontSize="6" Height="10" Padding="0" BorderThickness="0" Click="BtnDiffThrUp_Click"/>
                                            <RepeatButton x:Name="BtnDiffThrDown" Content="▼" FontSize="6" Height="10" Padding="0" BorderThickness="0" Click="BtnDiffThrDown_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <CheckBox x:Name="ChkZeroZeroWhite" IsChecked="False" VerticalAlignment="Center" ToolTip="When enabled: 0=0 → white, 255=255 → black" Checked="ChkZeroZeroWhite_Changed" Unchecked="ChkZeroZeroWhite_Changed">
                                <TextBlock Text="Flip (0=0→white)" FontSize="11"/>
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Comparison Info -->
            <GroupBox Grid.Row="1" Header="Comparison Info" Padding="8" Margin="0,0,0,6" Background="#F0F0F0">
                <Border BorderBrush="#A0A0A0" BorderThickness="1" Padding="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LblDiffMode" Foreground="#245A7A" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Margin="0,-2,0,4"/>
                        <Rectangle Grid.Row="0" Grid.Column="1" Width="1" Fill="#A0A0A0" Margin="5,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblMaxPositiveDev" Foreground="DimGray" FontSize="11" TextWrapping="NoWrap" VerticalAlignment="Center" Padding="0" Margin="0,-2,0,4"/>
                        <Rectangle Grid.Row="0" Grid.Column="3" Width="1" Fill="#A0A0A0" Margin="5,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" x:Name="LblMaxNegativeDev" Foreground="DimGray" FontSize="11" TextWrapping="NoWrap" VerticalAlignment="Center" Padding="0" Margin="0,-2,0,4"/>
                        <Rectangle Grid.Row="0" Grid.Column="5" Width="1" Fill="#A0A0A0" Margin="5,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" x:Name="LblAverageDev" Foreground="DimGray" FontSize="11" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="0" Margin="0,-2,0,4"/>

                        <Rectangle Grid.Row="1" Grid.ColumnSpan="7" Height="1" Fill="#A0A0A0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LblTotalPixelsDev" Foreground="DimGray" FontSize="11" TextWrapping="NoWrap" VerticalAlignment="Center" Padding="0,2" Margin="4,0,0,0"/>
                        <Rectangle Grid.Row="2" Grid.Column="1" Width="1" Fill="#A0A0A0" Margin="5,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LblDarkPixels" Foreground="DimGray" FontSize="11" TextWrapping="NoWrap" VerticalAlignment="Center" Padding="0,2"/>
                        <Rectangle Grid.Row="2" Grid.Column="3" Width="1" Fill="#A0A0A0" Margin="5,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" x:Name="LblBrightPixels" Foreground="DimGray" FontSize="11" TextWrapping="NoWrap" VerticalAlignment="Center" Padding="0,2"/>
                        <Rectangle Grid.Row="2" Grid.Column="5" Width="1" Fill="#A0A0A0" Margin="5,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="6" x:Name="LblFlickers" Foreground="DimGray" FontSize="11" TextWrapping="NoWrap" VerticalAlignment="Center" Padding="0,2"/>
                    </Grid>
                </Border>
            </GroupBox>

            <!-- AVTP Info -->
            <GroupBox Grid.Row="2" Header="AVTP Info" Height="56" Padding="8" Margin="0,0,0,6" Background="#F0F0F0">
                <TextBlock x:Name="LblStatus" TextWrapping="Wrap" Foreground="DimGray" FontSize="11"/>
            </GroupBox>

            <!-- LVDS Info (two-column layout) -->
            <GroupBox Grid.Row="3" Header="LVDS Info" Height="103" Padding="8" Margin="0,0,0,0" Background="#F0F0F0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblLvdsProtocol" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,10,0" FontSize="11" Text=""/>
                    <Rectangle Grid.Column="1" Width="1" Fill="Gray" Margin="2,0" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="10,0,0,0">
                        <TextBlock x:Name="LblLvdsFrameCount" Text="Frames: 0" Foreground="DimGray" FontSize="11"/>
                        <TextBlock x:Name="LblLvdsSyncLoss" Text="Sync_error: 0  CRC_error: 0  Parity_error: 0" Foreground="DimGray" Margin="0,0,0,0" FontSize="11"/>
                        <TextBlock x:Name="LblLvdsFps" Text="FPS: --" Foreground="DimGray" Margin="0,0,0,0" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="ECU State:" Foreground="DimGray" FontSize="11"/>
                            <Ellipse x:Name="MainEcuStateLed" Width="9" Height="9" Fill="#C62828" Stroke="#8E0000" StrokeThickness="1" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MainEcuStateText" Text="Stop/Failsafe" Foreground="DimGray" FontSize="11" Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Button Bar (under pane D) -->
        <Grid x:Name="ButtonBar" Grid.Row="3" Grid.ColumnSpan="2" Margin="4,6,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform X="105"/>
                </StackPanel.RenderTransform>
                <Button x:Name="BtnLoadFiles" Content="AVTP Input" Click="BtnLoadFiles_Click" Padding="10,4" />

                <Rectangle Width="1" Height="26" Fill="Gray" Margin="12,0,12,0" VerticalAlignment="Center" />

                <!-- Player buttons (keep order): Start Prev Next Record Snapshot Stop -->
                <Button x:Name="BtnStart" Content="▶ Start" Click="BtnStart_Click" Width="82" Height="28" MinWidth="82" MaxWidth="82" MinHeight="28" MaxHeight="28" Padding="10,4" Margin="0,0,6,0"/>
                <Button x:Name="BtnPrev" Content="⏮ Prev" Click="BtnSeqPrev_Click" Padding="10,4" Margin="0,0,6,0"/>
                <Button x:Name="BtnNext" Content="⏭ Next" Click="BtnSeqNext_Click" Padding="10,4" Margin="0,0,6,0"/>
                <Button x:Name="BtnRecord" Content="⏺ Record" Click="BtnRecord_Click" Width="100" Height="28" MinWidth="100" MaxWidth="100" MinHeight="28" MaxHeight="28" Padding="10,4" Margin="0,0,6,0" />
                <Button x:Name="BtnSave" Content="📷 Snapshot" Click="BtnSaveReport_Click" Padding="10,4" Margin="0,0,6,0" />
                <Button x:Name="BtnStop" Content="⏹ Stop" Click="BtnStop_Click" Padding="10,4" Margin="0,0,0,0" />

                <!-- Loop toggle is available only for loaded video sources. -->
                <ToggleButton x:Name="ChkLoopPlaying" VerticalAlignment="Center" Margin="12,0,0,0"
                              Visibility="Visible" IsEnabled="False" IsChecked="False"
                              Checked="ChkLoopPlaying_Changed" Unchecked="ChkLoopPlaying_Changed"
                              Width="28" Height="28" Padding="0" Background="Transparent" BorderBrush="Transparent"
                              BorderThickness="0" FocusVisualStyle="{x:Null}"
                              ToolTip="Toggle video loop playback">
                    <TextBlock x:Name="LoopPlaybackIcon" Text="↻" FontSize="28" FontWeight="Bold"
                               Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#888888" />
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Rectangle Width="1" Height="26" Fill="Gray" Margin="12,0,12,0" VerticalAlignment="Center" />

                <Button x:Name="BtnOpenSnapshots" Content="📂" Click="BtnOpenSnapshots_Click" Padding="8,4" Margin="0,0,6,0"
                    ToolTip="Open Outputs folder" />

                <TextBlock x:Name="LblSaveFeedback"
                           Text=""
                           Margin="0,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           TextTrimming="CharacterEllipsis"
                           MinWidth="220" />
            </StackPanel>
            <!-- Horizontal separator below buttons -->
            <Rectangle Grid.Row="1" Height="1" Fill="Gray" Margin="10,6,10,0" HorizontalAlignment="Stretch" />
        </Grid>

        <!-- ComparisonBar hidden (moved to SidebarInfo) -->
        <Border x:Name="ComparisonBar" Grid.Row="4" Grid.ColumnSpan="2" Visibility="Collapsed"/>

        <!-- Hidden Configuration Panels (used by popup windows via re-parenting) -->
        <StackPanel x:Name="HiddenConfigPanel" Visibility="Collapsed">
            <!-- 2. AVTP LVDS Simulation Control -->
            <GroupBox x:Name="GrpAppSettings" Padding="10" Margin="8">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⇉" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,5,0" />
                        <TextBlock Text="LVDS Simulation Control" FontWeight="Bold" Foreground="Black" />
                    </StackPanel>
                </GroupBox.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="FPS:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TxtFps" Width="48" Text="100"/>
                    </StackPanel>
                    <Rectangle Width="1" Height="24" Fill="Gray" Margin="0,0,10,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="Deviation:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TxtBDelta" Width="48" Text="0" TextChanged="BDelta_TextChanged"/>
                    </StackPanel>
                    <Rectangle Width="1" Height="24" Fill="Gray" Margin="0,0,10,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="Dead pixel ID:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TxtDeadPixelId" Width="48" Text="0" TextChanged="TxtDeadPixelId_TextChanged"/>
                    </StackPanel>
                    <Rectangle Width="1" Height="24" Fill="Gray" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkDarkPixelComp" Content="Dark pixel compensation" IsChecked="False" VerticalAlignment="Center"
                              ToolTip="Boost neighbors around dark pixels: +15% (N/S/E/W), +10% (diagonals), +5% (2-step N/S/E/W)"
                              Checked="ChkDarkPixelComp_Changed" Unchecked="ChkDarkPixelComp_Changed" />
                </StackPanel>
            </GroupBox>

            <!-- 3. Ethernet Configuration -->
            <GroupBox x:Name="GrpEthernetConfig" Header="Ethernet Configuration" Padding="10" Margin="8">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="NIC:" VerticalAlignment="Center" Width="88" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbLiveNic" Width="236" SelectionChanged="CmbLiveNic_SelectionChanged" Margin="0,0,4,0"/>
                        <Button Content="Refresh" Click="BtnRefreshNics_Click" Padding="6,4" Width="56"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="Source MAC:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtSrcMac" Width="116" Text="3C:CE:15:00:00:19" TextChanged="TxtMac_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="Dest MAC:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtDstMac" Width="116" Text="01:00:5E:16:00:12" TextChanged="TxtMac_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="VLAN ID:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtVlanId" Width="60" Text="70" TextChanged="TxtAvtpHeader_TextChanged"
                                 ToolTip="802.1Q VLAN ID (0-4095)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="VLAN Priority:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtVlanPriority" Width="60" Text="5" TextChanged="TxtAvtpHeader_TextChanged"
                                 ToolTip="802.1Q Priority Code Point (0-7)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="AVTP EtherType:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtAvtpEtherType" Width="60" Text="0x22F0" TextChanged="TxtAvtpHeader_TextChanged"
                                 ToolTip="AVTP EtherType (hex, e.g. 0x22F0)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                        <TextBlock Text="Stream ID byte:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtStreamIdLastByte" Width="60" Text="0x50" TextChanged="TxtAvtpHeader_TextChanged"
                                 ToolTip="Last byte of AVTP Stream ID (hex, e.g. 0x50)"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        </Grid>
    </DockPanel>
</Window>
