<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>docs\icon\SmartVisio.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);Aurix_Firmware\**;scripts\**;docs\**;python_sdk\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="docs\icon\SmartVisio.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpAvi" Version="3.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="SharpPcap" Version="6.3.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.3" />
  </ItemGroup>

  <!-- In-process REST automation host (localhost only). Provides Kestrel + Minimal API. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Basler.Pylon">
      <HintPath>C:\Program Files\Basler\pylon\Development\Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VilsSharpX.Tests" />
  </ItemGroup>

  <!-- WPF falls back to software rendering inside RDP sessions; allow GPU rendering when the host has one. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Media.EnableHardwareAccelerationInRdp" Value="true" />
  </ItemGroup>

</Project>
